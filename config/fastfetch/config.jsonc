{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/home/cole/.config/fastfetch/cyber_pig.png",
    "width": 24,
    "height": 12,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan"
    },
    "key": {
      "type": "icon"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "cyan",
        "at": "dim_white",
        "host": "light_blue"
      }
    },
    {
      "type": "separator",
      "string": "─"
    },
    "os",
    "kernel",
    "wm",
    "shell",
    "uptime",
    "memory",
    {
      "type": "break"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
